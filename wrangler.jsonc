// One Worker serves the app's static files, /api and /auth, with the map in D1.
// Setup steps: docs/cloudflare.md
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "adhd-assist",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "adhd-assist",
      "database_id": "423eeb20-4d2d-46a1-a096-79ebe645a028",
      "migrations_dir": "worker/migrations"
    }
  ],
  "observability": { "enabled": true }
}
